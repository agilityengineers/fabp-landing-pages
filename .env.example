# Anthropic API — required for AI content generation
ANTHROPIC_API_KEY=sk-ant-...

# Admin password — change before deploying
ADMIN_PASSWORD=change-me-before-deploying

# Your deployed site URL (no trailing slash) — used for sitemap + OG tags
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Email policy: this app does NOT send any email directly. All transactional
# email (welcome, login credentials, notifications) is sent by Brilliant
# Directories via the BD API. Operational alerts go to Slack via the
# webhooks below.

# Slack webhook for Brilliant Directories member-creation failure alerts.
# Slack-compatible payload (also works with Discord, Make, Zapier).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Provider Playbook — S3 storage for the gated PDF lead magnet.
# IAM user only needs s3:PutObject, s3:GetObject, s3:DeleteObject on the bucket.
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=fabp-playbooks-prod
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Slack webhook that receives every Provider Playbook lead.
# Recommend a dedicated channel separate from ALERT_WEBHOOK_URL.
# PLAYBOOK_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Cloudflare Turnstile (free) — bot protection on the public lead-capture form.
# Sign up at cloudflare.com/products/turnstile then create a site for this domain.
# TURNSTILE_SECRET_KEY=...
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=...

# Brand Voice Interview (BVI) Flow Tracker integration.
# Every Playbook + Invitation lead is pushed to BVI's public intake endpoint
# so the BVI sales rep sees it on their existing Kanban board.
# Defaults work; override base URL / path only if BVI moves or ships the lean
# /api/public/lead variant.
# BVI_API_BASE_URL=https://brand-voice-interview.com
# BVI_API_PATH=/api/public/intake-submit
# BVI_WEBHOOK_SECRET=...   # required to accept inbound BVI status webhooks

# Header secret for /api/cron/sync-bvi (Replit Scheduled Tasks etc.).
# When unset, the route falls back to the admin auth cookie so humans can
# still trigger a catch-up run from the dashboard.
# CRON_SECRET=...
