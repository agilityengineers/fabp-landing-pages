# Anthropic API — required for AI content generation
ANTHROPIC_API_KEY=sk-ant-...

# Admin password — change before deploying
ADMIN_PASSWORD=change-me-before-deploying

# Your deployed site URL (no trailing slash) — used for sitemap + OG tags
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Brilliant Directories member creation failure alerts — at least one of the two
# channel options below is needed to receive admin alerts on application failures.

# Option 1: Webhook (Slack / Discord / Make / Zapier compatible)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Option 2: Email via Resend
# RESEND_API_KEY=re_...                        ← required for email alerts
# ALERT_EMAIL=admin@yourdomain.com             ← recipient address
# ALERT_EMAIL_FROM=alerts@yourdomain.com       ← must be a Resend-verified sender domain
# ALERT_EMAIL_FROM_NAME=FABP Alerts            ← display name shown in the From field (default: "FABP Alerts")
# ALERT_EMAIL_SUBJECT_PREFIX=[FABP]            ← prefix for the alert subject line (default: "[FABP]")

# Optional: HubSpot private app token for CRM integration
# HUBSPOT_TOKEN=pat-...

# Provider Playbook — S3 storage for the gated PDF lead magnet.
# IAM user policy: s3:PutObject, s3:GetObject, s3:HeadObject, s3:CopyObject
# scoped to arn:aws:s3:::<bucket>/<prefix>/* — no wider permissions.
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=findabusinesspro
# AWS_S3_PREFIX=fabp-landing-pages
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Slack webhook that receives every Provider Playbook lead.
# Recommend a dedicated channel separate from ALERT_WEBHOOK_URL.
# PLAYBOOK_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Cloudflare Turnstile (free) — bot protection on the public lead-capture form.
# Sign up at cloudflare.com/products/turnstile then create a site for this domain.
# The site key is exposed to the browser by design; the secret key must stay
# server-only.
# TURNSTILE_SECRET_KEY=...
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=...
