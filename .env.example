# Anthropic API — required for AI content generation
ANTHROPIC_API_KEY=sk-ant-...

# Admin password — change before deploying. Used as the login credential AND
# as the fallback HMAC key for the signed admin session cookie when
# ADMIN_SESSION_SECRET is not set.
ADMIN_PASSWORD=change-me-before-deploying

# Optional but recommended: a dedicated secret used to HMAC-sign the admin
# session cookie. If unset, ADMIN_PASSWORD is used as the signing key.
# Use a long random value (e.g. `openssl rand -hex 32`).
# ADMIN_SESSION_SECRET=

# Optional: extra origins allowed for state-changing admin requests beyond the
# request's own Host. Comma-separated full URLs. Useful when the app is
# reached through multiple custom domains. The CSRF guard accepts any origin
# matching the request's Host by default.
# ALLOWED_ORIGINS=https://admin.example.com,https://www.example.com

# Your deployed site URL (no trailing slash) — used for sitemap + OG tags
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Email policy: this app does NOT send any email directly. All transactional
# email (welcome, login credentials, notifications) is sent by Brilliant
# Directories via the BD API. Operational alerts go to Slack via the
# webhooks below.

# Slack webhook for Brilliant Directories member-creation failure alerts.
# Slack-compatible payload (also works with Discord, Make, Zapier).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Provider Playbook — S3 storage for the gated PDF lead magnet.
# IAM user policy: s3:PutObject, s3:GetObject, s3:HeadObject, s3:CopyObject
# scoped to arn:aws:s3:::<bucket>/<prefix>/* — no wider permissions.
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=findabusinesspro
# AWS_S3_PREFIX=fabp-landing-pages
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Slack webhook that receives every Provider Playbook lead.
# Recommend a dedicated channel separate from ALERT_WEBHOOK_URL.
# PLAYBOOK_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Cloudflare Turnstile (free) — bot protection on the public lead-capture form.
# Sign up at cloudflare.com/products/turnstile then create a site for this domain.
# The site key is exposed to the browser by design; the secret key must stay
# server-only.
# TURNSTILE_SECRET_KEY=...
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=...

# Brand Voice Interview (BVI) Flow Tracker integration.
# Every Playbook + Invitation lead is pushed to BVI's public intake endpoint
# so the BVI sales rep sees it on their existing Kanban board.
# Defaults work; override base URL / path only if BVI moves or ships the lean
# /api/public/lead variant.
# BVI_API_BASE_URL=https://brand-voice-interview.com
# BVI_API_PATH=/api/public/intake-submit
# BVI_WEBHOOK_SECRET=...   # required to accept inbound BVI status webhooks

# Header secret for /api/cron/sync-bvi and /api/cron/retry-submissions.
# REQUIRED in production — without it, both cron endpoints return 503 and
# refuse to run. Send as `x-cron-secret: <value>` or
# `Authorization: Bearer <value>`.
# CRON_SECRET=...

# Optional: PostgreSQL connection-pool sizing. Defaults are sensible for a
# single reserved-VM deploy. Raise PG_POOL_MAX only if your DB tier has the
# connection headroom.
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECTION_TIMEOUT_MS=10000

# Optional: TTL (seconds) for presigned playbook download URLs. Default
# 3600 (1h), clamped to [60, 21600]. Bump if users tend to open the link
# later from email / saved notes; lower if you want links to be very short
# lived. Affects /api/playbook-leads and /api/playbook-jobs/[id] alike.
# PLAYBOOK_PRESIGN_TTL_SECONDS=3600

# Optional: pin the Chromium binary Puppeteer launches for PDF rendering.
# Defaults to the `chromium` executable on PATH (provided by `pkgs.chromium`
# in replit.nix). Set this if you need to override the path, e.g. to a
# vendored @sparticuz/chromium binary.
# PUPPETEER_EXECUTABLE_PATH=/nix/store/.../bin/chromium
